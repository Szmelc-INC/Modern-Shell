# Maintainer: SilverX (serainox420) <serainox@gmail.com>
pkgname=modern-shell
pkgver=0.1.0
pkgrel=1
pkgdesc="Modular, colorful zsh environment (zinit, p10k, fzf, zoxide) with snapshots and the msh TUI/CLI manager"
arch=('x86_64' 'aarch64')
url="https://github.com/Szmelc-INC/Modern-Shell"
license=('MIT')
depends=('zsh' 'git' 'fzf' 'zoxide')
makedepends=('go' 'python')
optdepends=(
  'eza: modern ls with icons and git status'
  'bat: syntax-highlighted cat and previews'
  'fd: fast file finder for fzf'
  'ripgrep: fast grep (search addon)'
  'highlight: fallback syntax highlighter'
  'tmux: terminal multiplexer (config included)'
  'nano: editor (config included)'
  'thefuck: corrects the previous command'
  'tldr: example-first cheatsheets'
  'git-delta: pretty git diffs'
  'wl-clipboard: clipboard addon on Wayland'
  'xclip: clipboard addon on X11'
  'python: msh-session desktop session snapshots'
  'hyprland: msh-session compositor backend'
  'uwsm: msh-session relaunches apps as UWSM units'
  'grim: msh-session window/monitor screenshots'
  'qt6-tools: qdbus6 for capturing unsaved Kate documents'
  'python-gobject: msh-session reads unsaved text over AT-SPI'
  'at-spi2-core: accessibility bus for unsaved text capture'
)
install=modern-shell.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0 GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -ldflags "-s -w -X main.version=$pkgver" -o build/msh ./cmd/msh
  ./build/msh completion zsh  > build/_msh
  ./build/msh completion bash > build/msh.bash
  ./build/msh completion fish > build/msh.fish
  python shell/bin/msh-session completion bash > build/msh-session.bash
  python shell/bin/msh-session completion fish > build/msh-session.fish
}

check() {
  cd "$pkgname-$pkgver"
  go test ./internal/store/
  bash tests/lint.sh
  bash tests/test-session.sh
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/msh "$pkgdir/usr/bin/msh"
  install -Dm755 shell/bin/msh-session "$pkgdir/usr/bin/msh-session"

  # Per-user setup uses the same installer (snapshot first, user layer kept).
  local share="$pkgdir/usr/share/$pkgname"
  install -dm755 "$share"
  cp -a shell configs install.sh uninstall.sh "$share/"
  find "$share" -name __pycache__ -type d -prune -exec rm -rf {} +
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/msh-setup" <<'EOF'
#!/bin/sh
# Set up Modern Shell for the current user (takes a snapshot of everything first).
exec bash /usr/share/modern-shell/install.sh --no-binary "$@"
EOF

  install -Dm644 build/_msh     "$pkgdir/usr/share/zsh/site-functions/_msh"
  install -Dm644 build/msh.bash "$pkgdir/usr/share/bash-completion/completions/msh"
  install -Dm644 build/msh.fish "$pkgdir/usr/share/fish/vendor_completions.d/msh.fish"
  install -Dm644 shell/completions/_msh-session "$pkgdir/usr/share/zsh/site-functions/_msh-session"
  install -Dm644 build/msh-session.bash "$pkgdir/usr/share/bash-completion/completions/msh-session"
  install -Dm644 build/msh-session.fish "$pkgdir/usr/share/fish/vendor_completions.d/msh-session.fish"

  install -Dm644 LICENSE   "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
